{
  "description": "Forwards every lifecycle event to the local agentsmon daemon.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "Interrupt": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }],
    "PostCompact": [{ "hooks": [{ "type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/forward.sh\"", "timeout": 1 }] }]
  }
}
